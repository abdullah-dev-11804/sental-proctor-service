APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8091
API_SHARED_SECRET=dev-secret-change-me

LOCAL_STORAGE_ROOT=./storage

IDENTITY_ENGINE=opencv_sface
IDENTITY_ALLOW_LEGACY_MATCHER=true
IDENTITY_MODEL_ROOT=./models
IDENTITY_YUNET_MODEL=face_detection_yunet_2023mar.onnx
IDENTITY_SFACE_MODEL=face_recognition_sface_2021dec.onnx
IDENTITY_PASS_THRESHOLD=0.42
IDENTITY_REVIEW_THRESHOLD=0.34
IDENTITY_MIN_BRIGHTNESS=35
IDENTITY_MIN_BLUR=35
IDENTITY_MIN_FACE_CONFIDENCE=0.88
IDENTITY_MIN_FACE_WIDTH_RATIO=0.16
IDENTITY_MAX_FACE_WIDTH_RATIO=0.62
IDENTITY_CENTER_TOLERANCE_X=0.22
IDENTITY_CENTER_TOLERANCE_Y=0.28

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=sental-minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET_TEMP=proctoring-temp
S3_BUCKET_EVIDENCE=proctoring-evidence
S3_BUCKET_REPORTS=proctoring-reports

LIVEKIT_URL=wss://livekit.example.kz
LIVEKIT_API_KEY=dev-livekit-key
LIVEKIT_API_SECRET=dev-livekit-secret

MOODLE_WEBHOOK_URL=https://moodle.example.kz/local/proctorcore/webhook.php
MOODLE_WEBHOOK_SECRET=change-me-webhook-secret
